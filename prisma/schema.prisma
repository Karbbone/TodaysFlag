generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Country {
  CC             String          @id
  NameENG        String
  NameFRA        String
  NameESP        String
  Flag           String
  Capital        String?
  Map            String
  ONUMember      Boolean
  GuessedCountry GuessedCountry?
  currency_name  String
  currency       Currency @relation(fields: [currency_name], references: [name])
}

model Currency{
  name String @id
  symbol String @unique
  countries Country[]
}

model GuessedCountry {
  guessedAt DateTime @id @default(now())
  countryCC String   @unique
  country   Country  @relation(fields: [countryCC], references: [CC])
}
