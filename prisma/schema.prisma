model Country {
  cc             String          @id
  name_eng       String
  name_fra       String
  name_esp       String
  flag           String
  capital        String?
  map            String
  onu_member     Boolean
  currency_name  String
  phone_code     String
  region_id      Int
  subregion_id   Int
  latitude       Float
  longitude      Float
  population     Int
  side_drive     String
  time_zone      String

  guessed_country GuessedCountry?
  currency       Currency  @relation("CurrencyRelation", fields: [currency_name], references: [name])
  region         Region    @relation("RegionRelation", fields: [region_id], references: [id])
  subregion      Subregion @relation("SubregionRelation", fields: [subregion_id], references: [id])
  languages      Language[] @relation("LanguageRelation")
}


model Language {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("LanguageRelation")
}
model Currency {
  name      String    @id
  symbol    String    @unique
  countries Country[] @relation("CurrencyRelation")
}

model GuessedCountry {
  guessed_at DateTime @id @default(now())
  country_cc String   @unique
  country   Country  @relation(fields: [country_cc], references: [cc])
}

model Region {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("RegionRelation")
}

model Subregion {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("SubregionRelation")
}
