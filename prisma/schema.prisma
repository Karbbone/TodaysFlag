model Country {
  CC             String          @id
  NameENG        String
  NameFRA        String
  NameESP        String
  Flag           String
  Capital        String?
  Map            String
  ONUMember      Boolean
  currency_name  String
  phone_code     String
  region_id      Int
  subregion_id   Int
  latitude       Float
  longitude      Float
  population     Int
  side_drive     String
  time_zone      String

  GuessedCountry GuessedCountry?
  currency       Currency  @relation("CurrencyRelation",fields: [currency_name], references: [name])
  region         Region    @relation("RegionRelation", fields: [region_id], references: [id])
  subregion      Subregion @relation("SubregionRelation", fields: [subregion_id], references: [id])
  languages      Language[] @relation("LanguageRelation")
}

model Language {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("LanguageRelation")
}
model Currency {
  name      String    @id
  symbol    String    @unique
  countries Country[] @relation("CurrencyRelation")
}

model GuessedCountry {
  guessedAt DateTime @id @default(now())
  countryCC String   @unique
  country   Country  @relation(fields: [countryCC], references: [CC])
}

model Region {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("RegionRelation")
}

model Subregion {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("SubregionRelation")
}
