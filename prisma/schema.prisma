model Country {
  CC             String          @id
  NameENG        String
  NameFRA        String
  NameESP        String
  Flag           String
  Capital        String?
  Map            String
  ONUMember      Boolean
  currency_name  String
  phone_code     String
  regionId       Int
  subregionId    Int

  GuessedCountry GuessedCountry?
  currency       Currency  @relation("CurrencyRelation",fields: [currency_name], references: [name])
  region         Region    @relation("RegionRelation", fields: [regionId], references: [id])
  subregion      Subregion @relation("SubregionRelation", fields: [subregionId], references: [id])
}

model Currency {
  name      String    @id
  symbol    String    @unique
  countries Country[] @relation("CurrencyRelation")
}

model GuessedCountry {
  guessedAt DateTime @id @default(now())
  countryCC String   @unique
  country   Country  @relation(fields: [countryCC], references: [CC])
}

model Region {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("RegionRelation")
}

model Subregion {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  countries Country[] @relation("SubregionRelation")
}
